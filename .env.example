# ============================================================
# Environment Variables Template
# Copy this file to .env and configure your keys
# NEVER commit your actual .env file to Git!
# ============================================================

# LLM Provider Selection: openai | gemini | anthropic | local | mock
LLM_PROVIDER=mock
LLM_MODEL=mock-llm-v1

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Model (Ollama) Base URL
OLLAMA_BASE_URL=http://localhost:11434

# Optional: HuggingFace Token (for gated repositories or rate limits)
HF_TOKEN=your_huggingface_token_here

# Execution & Cost Control Settings
MAX_LLM_SAMPLES=100
LLM_CACHE_ENABLED=true
LLM_TEMPERATURE=0.5
LLM_NUM_PATHS=8
